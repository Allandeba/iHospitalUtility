      "targets": [
        {
          "refId": "A",
          "expr": "(max(ihospital_probe_duration_seconds{service_name=\"ihospitalutility-monitor\",check=\"home\"})) and on() (time() - max(ihospital_probe_last_run_timestamp_seconds{service_name=\"ihospitalutility-monitor\"}) < 180)",
